+        guint16 open_fdt_delta;
 
         if (!goodix_cmd_parse_fdt_manual_reply (dev, &pl, &pl_len, &error))
           {
@@ -593,11 +595,17 @@ goodix_open_ssm_handler (FpiSsm   *ssm,
             return;
           }
 
+        /* The 5381 fallback OTP contains a zero FDT delta. Keep that value for
+         * actual touch detection, but allow the smallest normal OTP-derived
+         * tolerance while measuring the open-time no-finger baseline. */
+        open_fdt_delta = goodix_open_fdt_tolerance (
+            goodix_is_experimental_5381 (dev), self->calib.delta_fdt);
+
         /* Validate against the open-time FDT base we just recorded. */
         if (!goodix_device_is_fdt_base_valid (pl + 4,
                                               self->fdt_data_tx_on,
                                               GOODIX_FDT_BASE_LEN,
-                                              self->calib.delta_fdt))
