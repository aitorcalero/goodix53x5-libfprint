@@ -163,6 +163,18 @@ goodix_device_verify_otp (const guint8 *otp,
     {
       fp_warn ("OTP hash mismatch: received 0x%02x, computed 0x%02x",
                received_hash, computed_hash);
+
+      /* Different HTK32 revisions may store the checksum at another offset.
+       * Report candidates without exposing the OTP contents. */
+      for (gsize hash_offset = 0; hash_offset < otp_len; hash_offset++)
+        {
+          memcpy (data, otp, hash_offset);
+          memcpy (data + hash_offset, otp + hash_offset + 1,
+                  otp_len - hash_offset - 1);
+          if (otp[hash_offset] ==
+              goodix_device_compute_otp_hash (data, data_len))
+            fp_warn ("Possible OTP hash byte at offset %zu", hash_offset);
+        }
       return FALSE;
     }
 
