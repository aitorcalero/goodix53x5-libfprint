Date: Tue, 8 Sep 2026 17:11:10 +0200
Subject: [PATCH 6/7] Let 5381 FDT baseline settle between retries

---
 docs/27c6-5381-porting.md               |  4 ++++
 drivers/goodix53x5/goodix53x5-fdt.h     | 24 ++++++++++++++++++++++++
 drivers/goodix53x5/goodix53x5-session.c | 25 ++++++++++++++++++++-----
 tests/test_goodix53x5_fdt.c             |  5 +++++
 4 files changed, 53 insertions(+), 5 deletions(-)

diff --git a/docs/27c6-5381-porting.md b/docs/27c6-5381-porting.md
index e897183..e2b3621 100644
--- a/docs/27c6-5381-porting.md
+++ b/docs/27c6-5381-porting.md
@@ -25,6 +25,10 @@ finger-event validation, but open-time baseline stabilization uses a minimum
 tolerance of 3. Three is the smallest value produced by the normal OTP formula;
 without this open-only floor, ordinary sensor noise made consecutive baseline
 reads require bit-for-bit equality and caused intermittent device-open failures.
+The 5381 open path also spaces retries by 100 ms and permits up to ten retries,
+because back-to-back reads immediately after enrollment were only about 10 ms
+apart and repeatedly sampled the same unsettled state. Failures report the
+observed maximum delta without logging raw FDT or biometric data.
 
 ## Calibration evidence
 
diff --git a/drivers/goodix53x5/goodix53x5-fdt.h b/drivers/goodix53x5/goodix53x5-fdt.h
index 6edff60..833de4f 100644
--- a/drivers/goodix53x5/goodix53x5-fdt.h
+++ b/drivers/goodix53x5/goodix53x5-fdt.h
@@ -14,6 +14,8 @@
  * non-fallback OTP formula (diff == 1), so use it only for open-time
  * stabilization. Finger-down/up detection keeps the original OTP value. */
 #define GOODIX5381_OPEN_FDT_MIN_DELTA 3u
+#define GOODIX5381_OPEN_FDT_MAX_RETRIES 10u
+#define GOODIX5381_OPEN_FDT_RETRY_DELAY_MS 100u
 
 static inline guint16
 goodix_open_fdt_tolerance (gboolean experimental_5381,
@@ -24,3 +26,25 @@ goodix_open_fdt_tolerance (gboolean experimental_5381,
 
   return otp_delta;
 }
+
+static inline guint16
+goodix_fdt_max_delta (const guint8 *data1,
+                      const guint8 *data2,
+                      gsize         len)
+{
+  guint16 max_delta = 0;
+
+  for (gsize i = 0; i < len; i += 2)
+    {
+      guint16 val1 = data1[i] | ((guint16) data1[i + 1] << 8);
+      guint16 val2 = data2[i] | ((guint16) data2[i + 1] << 8);
+      guint16 shifted1 = val1 >> 1;
+      guint16 shifted2 = val2 >> 1;
+      guint16 delta = shifted1 > shifted2 ? shifted1 - shifted2 :
+                                            shifted2 - shifted1;
+
+      max_delta = MAX (max_delta, delta);
+    }
+
+  return max_delta;
+}
diff --git a/drivers/goodix53x5/goodix53x5-session.c b/drivers/goodix53x5/goodix53x5-session.c
index 66116c6..6ab8d3a 100644
--- a/drivers/goodix53x5/goodix53x5-session.c
+++ b/drivers/goodix53x5/goodix53x5-session.c
@@ -588,6 +588,10 @@ goodix_open_ssm_handler (FpiSsm   *ssm,
         const guint8 *pl;
         gsize pl_len;
         guint16 open_fdt_delta;
+        guint16 observed_fdt_delta;
+        gboolean experimental_5381;
+        guint max_retries;
+        guint retry_delay_ms;
 
         if (!goodix_cmd_parse_fdt_manual_reply (dev, &pl, &pl_len, &error))
           {
@@ -598,8 +602,15 @@ goodix_open_ssm_handler (FpiSsm   *ssm,
         /* The 5381 fallback OTP contains a zero FDT delta. Keep that value for
          * actual touch detection, but allow the smallest normal OTP-derived
          * tolerance while measuring the open-time no-finger baseline. */
+        experimental_5381 = goodix_is_experimental_5381 (dev);
         open_fdt_delta = goodix_open_fdt_tolerance (
-            goodix_is_experimental_5381 (dev), self->calib.delta_fdt);
+            experimental_5381, self->calib.delta_fdt);
+        observed_fdt_delta = goodix_fdt_max_delta (
+            pl + 4, self->fdt_data_tx_on, GOODIX_FDT_BASE_LEN);
+        max_retries = experimental_5381 ?
+            GOODIX5381_OPEN_FDT_MAX_RETRIES : GOODIX_OPEN_FDT_MAX_RETRIES;
+        retry_delay_ms = experimental_5381 ?
+            GOODIX5381_OPEN_FDT_RETRY_DELAY_MS : 0;
 
         /* Validate against the open-time FDT base we just recorded. */
         if (!goodix_device_is_fdt_base_valid (pl + 4,
@@ -607,15 +618,19 @@ goodix_open_ssm_handler (FpiSsm   *ssm,
                                               GOODIX_FDT_BASE_LEN,
                                               open_fdt_delta))
           {
-            if (self->open_fdt_retries++ < GOODIX_OPEN_FDT_MAX_RETRIES)
+            if (self->open_fdt_retries++ < max_retries)
               {
-                fp_warn ("Open FDT validation unstable, retrying (%u/%u)",
+                fp_warn ("Open FDT validation unstable: observed delta %u, "
+                         "limit %u; retrying (%u/%u) after %ums",
+                         observed_fdt_delta, open_fdt_delta,
                          self->open_fdt_retries,
-                         GOODIX_OPEN_FDT_MAX_RETRIES);
+                         max_retries, retry_delay_ms);
                 g_free (self->fdt_data_tx_on);
                 self->fdt_data_tx_on = g_memdup2 (pl + 4,
                                                   GOODIX_FDT_BASE_LEN);
-                fpi_ssm_jump_to_state (ssm, GOODIX_OPEN_FDT_TX_ON_2);
+                fpi_ssm_jump_to_state_delayed (ssm,
+                                               GOODIX_OPEN_FDT_TX_ON_2,
+                                               retry_delay_ms);
                 return;
               }
 
diff --git a/tests/test_goodix53x5_fdt.c b/tests/test_goodix53x5_fdt.c
index ab380d2..87ea9bc 100644
--- a/tests/test_goodix53x5_fdt.c
+++ b/tests/test_goodix53x5_fdt.c
@@ -20,6 +20,9 @@ static int failures;
 int
 main (void)
 {
+  guint8 baseline[4] = { 0x00, 0x02, 0x00, 0x04 };
+  guint8 noisy[4] = { 0x06, 0x02, 0x0a, 0x04 };
+
   CHECK (goodix_open_fdt_tolerance (TRUE, 0) ==
          GOODIX5381_OPEN_FDT_MIN_DELTA,
          "5381 fallback gets a nonzero open-time tolerance");
@@ -30,6 +33,8 @@ main (void)
          "5381 values above the minimum remain unchanged");
   CHECK (goodix_open_fdt_tolerance (FALSE, 0) == 0,
          "other devices keep their OTP tolerance");
+  CHECK (goodix_fdt_max_delta (baseline, noisy, sizeof (baseline)) == 5,
+         "maximum FDT delta is reported in shifted sensor units");
 
   return failures != 0;
 }
